@host = http://localhost:5229

GET {{host}}/openapi/v1.json
Accept: application/json

### SPENDING CATEGORIES ###

GET {{host}}/api/transactioncategories/1
Accept: application/json

###
GET  {{host}}/api/transactioncategories?take=50&skip=0
Accept: application/json

###
DELETE  {{host}}/api/transactioncategories/1
Accept: application/json
###
POST {{host}}/api/transactioncategories
Content-Type: application/json

{
  "name": "Groceries"
}
###
PUT {{host}}/api/transactioncategories/2
Content-Type: application/json

{
  "name": "",
  "description": "Food and household items2"
}

### TRANSACTION SOURCES ###

GET {{host}}/api/transactionsource/1
Accept: application/json

###
GET  {{host}}/api/transactionsource?take=1&skip=0
Accept: application/json

###
POST {{host}}/api/transactionsource
Content-Type: application/json

{
  "name": "TEST123",
  "ownerId": 1
}


### TRANSACTIONS ###

GET {{host}}/api/transactions/1
Accept: application/json

###
GET  {{host}}/api/transactions?take=5&skip=0&transactionSourceId=1
Accept: application/json

### AUTOCOMPLETE ###
GET  {{host}}/api/autocomplete/transactionsource/1
Accept: application/json

###

GET  {{host}}/api/autocomplete/transactionsource?take=5&skip=0&search=Hannah
Accept: application/json
