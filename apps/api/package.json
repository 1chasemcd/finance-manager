{
  "name": "@finapp/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --env dev",
    "cf-typegen": "wrangler types ./src/types/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset:local": "rm -rf .wrangler/state && pnpm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@finapp/result": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  }
}
