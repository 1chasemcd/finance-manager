{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finapp",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-09-25",
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "dev": {
      "main": "src/index.dev.ts",
      "secrets": {
        "required": ["DEV_USER"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "drizzle",
          "migrations_pattern": "drizzle/*/migration.sql",
        },
      ],
    },
    "prod": {
      "main": "src/index.ts",
      "vars": {
        "POLICY_AUD": "daa9462a331f6fef1eebb5e8842dc10e745eec06d0d8fe0775f001433867b741",
        "TEAM_DOMAIN": "https://mcdnld.cloudflareaccess.com",
        "LOG_LEVEL": "info",
      },
      "minify": true,
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "drizzle",
          "migrations_pattern": "drizzle/*/migration.sql",
          "database_id": "9f099c2f-69a2-45f4-ba3d-69fe5febd79d",
          "database_name": "finapp-db",
        },
      ],
    },
  },
}
